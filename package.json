{
  "name": "logcolombia-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@aws-amplify/react-native": "^1.3.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "aws-amplify": "^6.22.1",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-ocr-plus": "^2.0.6",
    "react-native-vision-camera-worklets": "^5.2.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "amplify:outputs": "npx ampx generate outputs --app-id $AMPLIFY_APP_ID --branch ${AMPLIFY_BRANCH:-main} --out-dir .",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production"
