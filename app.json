{
  "expo": {
    "name": "Logcolombia Placas",
    "slug": "logcolombia-placas",
    "scheme": "logcolombiaplacas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.logcolombia.placas",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "La cámara se usa para leer las placas de los vehículos en tiempo real.",
        "NSLocationWhenInUseUsageDescription": "La ubicación se registra cuando se detecta un vehículo del listado para coordinar la captura.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.logcolombia.placas",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F2B4C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La ubicación se registra cuando se detecta un vehículo del listado para coordinar la captura."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-asset"
    ]
  }
}
